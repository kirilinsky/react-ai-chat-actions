{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "sourceMap": false,
    "paths": {
      "src/*": ["./src/*"],
      "react-ai-chat-actions": ["./src/index.ts"]
    }
  },
  "include": ["src", "dev", ".storybook"],
  "exclude": ["node_modules"]
}
